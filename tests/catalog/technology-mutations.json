{
  "$comment": "Negative controls for tools/catalog/check-technology.mjs (V-23, D-039). Each case mutates a temporary copy of the repository; the checker must exit 1 with an ERROR line starting with expect.error. Run: node tools/validate/run-validator-tests.mjs",
  "version": 1,
  "cases": [
    {
      "id": "tech-rename-capability",
      "description": "A technology capability is renamed away from the Step 20 inventory",
      "edits": [{ "file": "catalog/technology-capabilities.yaml", "op": "replace", "find": "    name: csharp-nullability\n", "with": "    name: csharp-null-safety\n" }],
      "expect": { "validator": "technology", "error": "V-23.1 inventory" }
    },
    {
      "id": "tech-omit-capability",
      "description": "The last inventory capability is removed",
      "edits": [{ "file": "catalog/technology-capabilities.yaml", "op": "regex", "pattern": "  - id: TECH-ASPNET-014\\n[\\s\\S]*$", "with": "" }],
      "expect": { "validator": "technology", "error": "V-23.1 inventory" }
    },
    {
      "id": "tech-duplicate-id",
      "description": "Two records share an id",
      "edits": [{ "file": "catalog/technology-capabilities.yaml", "op": "replace", "find": "  - id: TECH-CSHARP-002\n", "with": "  - id: TECH-CSHARP-001\n" }],
      "expect": { "validator": "technology", "error": "V-23.1 inventory" }
    },
    {
      "id": "tech-verified-without-evidence",
      "description": "A record is VERIFIED while its evidence says the evals are NOT_RUN",
      "edits": [{ "file": "catalog/technology-capabilities.yaml", "op": "regex", "pattern": "(  - id: TECH-ASPNET-013\\n[\\s\\S]*?    status: )IMPLEMENTED", "with": "$1VERIFIED" }],
      "expect": { "validator": "technology", "error": "V-23.2 records" }
    },
    {
      "id": "tech-unknown-engineering-capability",
      "description": "A record links an engineering capability that does not exist",
      "edits": [{ "file": "catalog/technology-capabilities.yaml", "op": "replace", "find": "    engineering_capabilities: [CAP-06-008]\n", "with": "    engineering_capabilities: [CAP-06-099]\n" }],
      "expect": { "validator": "technology", "error": "V-23.2 records" }
    },
    {
      "id": "tech-reference-not-listed",
      "description": "The technology reference is removed from its skill's References table",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-performance/SKILL.md", "op": "regex", "pattern": "\\| \\[references/aspnetcore-performance\\.md\\][^\\n]*\\n", "with": "" }],
      "expect": { "validator": "technology", "error": "V-23.3 mapping" }
    },
    {
      "id": "tech-section-missing",
