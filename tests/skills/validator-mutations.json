      "edits": [{ "file": "plugins/codejadee-chayen-framework/plugin.json", "op": "replace", "find": "  \"name\": \"codejadee-chayen-framework\",\n", "with": "  \"name\": \"codejadee-chayen-framework\",\n  \"category\": \"tools\",\n" }],
