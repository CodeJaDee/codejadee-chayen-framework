{
  "$comment": "Negative controls for tools/validate/validate-package.mjs (SKILL_QUALITY_GATES G-13). Each case mutates a temporary copy of the repository; the validator must exit 1 with an ERROR line starting with expect.error. Paths are repository-relative. Run: node tools/validate/run-validator-tests.mjs",
  "version": 1,
  "cases": [
    {
      "id": "sk-frontmatter-invalid-yaml",
      "description": "Invalid YAML: unterminated quoted value in SKILL.md frontmatter",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "replace", "find": "name: chayen-testing\n", "with": "name: \"chayen-testing\n" }],
      "expect": { "validator": "package", "error": "V-05 skills" }
    },
    {
      "id": "sk-frontmatter-yaml-unsafe-value",
      "description": "Invalid YAML: plain scalar containing ': '",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "replace", "find": "name: chayen-testing\n", "with": "name: chayen-testing\nlicense: see: LICENSE\n" }],
      "expect": { "validator": "package", "error": "V-05 skills" }
    },
    {
      "id": "sk-frontmatter-unsupported-field",
      "description": "Unsupported frontmatter field (PT-02)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "replace", "find": "name: chayen-testing\n", "with": "name: chayen-testing\nwhen_to_use: Use for tests\n" }],
      "expect": { "validator": "package", "error": "V-05 skills" }
    },
    {
      "id": "sk-duplicate-skill-name",
      "description": "Two skill directories declare the same name",
      "edits": [{ "op": "copydir", "from": "plugins/codejadee-chayen-framework/skills/chayen-testing", "to": "plugins/codejadee-chayen-framework/skills/chayen-testing-copy" }],
      "expect": { "validator": "package", "error": "V-05 skills" }
    },
    {
      "id": "sk-name-differs-from-directory",
      "description": "Frontmatter name does not equal the directory (PT-03)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "replace", "find": "name: chayen-testing\n", "with": "name: chayen-tests\n" }],
      "expect": { "validator": "package", "error": "V-05 skills" }
    },
    {
      "id": "sk-skill-not-in-catalog",
      "description": "A shipped skill without a catalog mapping (CA-01)",
      "edits": [
        { "op": "copydir", "from": "plugins/codejadee-chayen-framework/skills/chayen-testing", "to": "plugins/codejadee-chayen-framework/skills/chayen-qa" },
        { "file": "plugins/codejadee-chayen-framework/skills/chayen-qa/SKILL.md", "op": "replace", "find": "name: chayen-testing\n", "with": "name: chayen-qa\n" }
      ],
      "expect": { "validator": "package", "error": "V-19 catalog-mapping" }
    },
    {
      "id": "sk-missing-section",
      "description": "Entry skill without the Safety boundaries section",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-backend/SKILL.md", "op": "replace", "find": "## Safety boundaries\n", "with": "" }],
      "expect": { "validator": "package", "error": "V-17 skill-sections" }
    },
    {
      "id": "sk-section-out-of-order",
      "description": "Safety boundaries moved after References",
      "edits": [
        { "file": "plugins/codejadee-chayen-framework/skills/chayen-repository/SKILL.md", "op": "replace", "find": "## Safety boundaries\n", "with": "### Safety notes\n" },
        { "file": "plugins/codejadee-chayen-framework/skills/chayen-repository/SKILL.md", "op": "append", "content": "\n## Safety boundaries\n\n- Read-only access only. Never modify files or instruction files in the repository.\n" }
      ],
      "expect": { "validator": "package", "error": "V-17 skill-sections" }
    },
    {
      "id": "sk-missing-scope-line",
      "description": "No **Scope:** line before When to use (R-24 gate)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-repository/SKILL.md", "op": "replace", "find": "**Scope:** read-only", "with": "Scope: read-only" }],
      "expect": { "validator": "package", "error": "V-17 skill-sections" }
    },
    {
      "id": "sk-broken-reference-path",
      "description": "SKILL.md links a reference file that does not exist",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-frontend/SKILL.md", "op": "replace", "find": "[references/angular.md](references/angular.md)", "with": "[references/angular.md](references/angularjs.md)" }],
      "expect": { "validator": "package", "error": "V-08 links" }
    },
    {
      "id": "sk-broken-anchor",
