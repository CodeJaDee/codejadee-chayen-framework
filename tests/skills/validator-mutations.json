    {
      "id": "sk-description-catch-all",
      "description": "Overly broad description with catch-all wording (DS-04)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "regex", "pattern": "^description: .*$", "flags": "m", "with": "description: Help with any coding task and everything else developers need, including tests. Not for production monitoring or load testing." }],
      "expect": { "validator": "package", "error": "V-20 description-breadth" }
