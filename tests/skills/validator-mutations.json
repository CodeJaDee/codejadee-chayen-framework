      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-backend/references/data-access.md", "op": "replace", "find": "---\nkind: technology\n---\n", "with": "" }],
      "expect": { "validator": "package", "error": "V-18 reference-kinds" }
