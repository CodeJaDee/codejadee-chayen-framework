      "expect": { "validator": "package", "error": "V-08 links" }
    },
    {
      "id": "sk-unreachable-reference",
      "description": "A reference file that SKILL.md never links (RF-02)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/references/orphan.md", "op": "write", "content": "---\nkind: checklist\n---\n# Orphan\n\n## One\n\nAn orphaned checklist that no skill links to.\n\n## Two\n\nA second section with enough content to be valid.\n" }],
      "expect": { "validator": "package", "error": "V-08 links" }
    },
    {
      "id": "sk-reference-without-kind",
