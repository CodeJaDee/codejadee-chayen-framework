      "description": "Description names no concrete stack, tool, or artifact (DS-02)",
      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-testing/SKILL.md", "op": "regex", "pattern": "^description: .*$", "flags": "m", "with": "description: Improve software quality for developers in many situations with helpful engineering advice. Not for marketing copy or legal review." }],
      "expect": { "validator": "package", "error": "V-20 description-breadth" }
