      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-implementation/references/task-contract.md", "op": "replace", "find": "## Procedure\n", "with": "## Steps\n" }],
      "expect": { "validator": "package", "error": "V-18 reference-kinds" }
    },
    {
      "id": "sk-recipe-todo-only",
