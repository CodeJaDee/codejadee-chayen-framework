      "edits": [{ "file": "plugins/codejadee-chayen-framework/skills/chayen-implementation/references/task-contract.md", "op": "replace", "find": "capabilities: [CAP-04-001, CAP-04-002, CAP-04-003]", "with": "capabilities: [CAP-04-001, CAP-04-002, CAP-04-003, CAP-05-001]" }],
      "expect": { "validator": "package", "error": "V-19 catalog-mapping" }
    },
    {
      "id": "sk-recipe-lists-planned-capability",
